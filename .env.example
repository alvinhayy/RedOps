REDOPS_DB_PATH=data/redops.db
REDOPS_KNOWLEDGE_DIR=knowledge
REDOPS_WRITEUPS_DIR=writeups
REDOPS_EMBEDDING_PROVIDER=hash
REDOPS_EMBEDDING_MODEL=redops-hash-v1
REDOPS_EMBEDDING_DIMENSION=384
REDOPS_LLM_PROVIDER=extractive
# Provider-neutral override (takes precedence over provider defaults)
# REDOPS_API_KEY=
# REDOPS_API_BASE_URL=https://api.openai.com/v1
# REDOPS_LLM_MODEL=gpt-4.1-mini
# Provider-specific credentials (use only the one selected above)
# OPENAI_API_KEY=
# ZAI_API_KEY=
# DEEPSEEK_API_KEY=
# ORCAROUTER_API_KEY=
# REDOPS_ORCAROUTER_BASE_URL=https://your-orcarouter-endpoint/v1
# Optional separate embedding endpoint/key
# REDOPS_EMBEDDING_API_KEY=
# REDOPS_EMBEDDING_API_BASE_URL=https://api.openai.com/v1
REDOPS_TOP_K=6
REDOPS_VECTOR_WEIGHT=0.65
# Optional external Android runtime MCP (uiautomator2-mcp); no token is stored.
# REDOPS_MOBILE_MCP_PYTHON=/absolute/path/uiautomator2-mcp/.venv/bin/python
# REDOPS_MOBILE_MCP_SERVER=/absolute/path/uiautomator2-mcp/server.py
# REDOPS_MOBILE_DEVICE_SERIAL=emulator-5554
# Optional setup-specific MCP connectors; inject secrets from a secret manager.
# BURP_API_URL=http://127.0.0.1:1337
# CAMOUFOX_HEADLESS=true
# AD/identity agent only (not mobile):
# BLOODHOUND_URL=http://127.0.0.1:8080
# NEO4J_URI=bolt://127.0.0.1:7687
# GHIDRA_PROJECT_DIR=/absolute/path/engagements/current/ghidra
# R2_WORKSPACE=/absolute/path/engagements/current/static
# TERMINAL_MCP_WORKSPACE=/absolute/path/engagements/current
# TERMINAL_MCP_ALLOWED_COMMANDS=adb,frida,jadx,apktool,pytest,redops
