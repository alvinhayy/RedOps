#!/bin/sh
set -eu

REDOPS_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export REDOPS_ROOT

exec python3 - "$@" <<'PY'
import json
import os
import shutil
import sys
from pathlib import Path

root = Path(os.environ["REDOPS_ROOT"])
config_path = Path.home() / ".config/opencode/opencode.json"
config = json.loads(config_path.read_text(encoding="utf-8"))
try:
    options = config["provider"]["zai"]["options"]
    api_key = options["apiKey"]
    base_url = options["baseURL"]
except (KeyError, TypeError) as exc:
    raise SystemExit(f"Z.ai provider config is incomplete: {config_path}") from exc

if not api_key:
    raise SystemExit(f"Z.ai API key is empty: {config_path}")

os.environ.update(
    REDOPS_LLM_PROVIDER="zai",
    ZAI_API_KEY=api_key,
    REDOPS_API_BASE_URL=base_url,
    REDOPS_LLM_MODEL="glm-5.3",
)

binary = root / ".venv/bin/redops"
if not binary.exists():
    found = shutil.which("redops")
    if not found:
        raise SystemExit(f"RedOps CLI not found; activate the venv or install the project: {binary}")
    binary = Path(found)

arguments = sys.argv[1:] or ["query", "ringkas fungsi RedOps", "--top-k", "3"]
os.execv(str(binary), [binary.name, *arguments])
PY
